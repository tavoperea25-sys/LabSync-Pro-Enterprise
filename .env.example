# =============================================================================
# Variables de entorno para docker-compose.yml (raíz del proyecto)
#
# Copia este archivo a ".env" en la raíz y ajusta los valores antes de un
# despliegue real. Si no creas ningún ".env", docker-compose.yml usa
# exactamente los valores por defecto mostrados abajo — el comportamiento
# de desarrollo local no cambia.
#
# IMPORTANTE: estos valores por defecto son de desarrollo local únicamente.
# Si vas a exponer estos servicios más allá de tu máquina, cámbialos antes.
#
# Nota de acoplamiento: si cambias MINIO_ROOT_USER/MINIO_ROOT_PASSWORD aquí,
# revisa también MINIO_ACCESS_KEY/MINIO_SECRET_KEY en backend/.env — son
# las credenciales que el backend usa para autenticarse contra MinIO, y
# deben coincidir con las que este archivo le da al contenedor de MinIO.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=labsync
POSTGRES_PASSWORD=labsync
POSTGRES_DB=labsync

# --- MinIO (almacenamiento de objetos) ---
MINIO_ROOT_USER=labsync
MINIO_ROOT_PASSWORD=labsync123

# Clave maestra de cifrado en reposo (SSE-S3) de los buckets de
# documentos/evidencias — ver docs/16-seguridad.md sección 5. En un
# despliegue real, esta clave debería venir de un secret manager, no de
# este archivo.
MINIO_KMS_SECRET_KEY=labsync-master-key:w09R7021SABtUCVnFUVbShEhWfn2ONiWmFbD0ruskaw=
