# "desarrollo" (default) → docker-entrypoint.sh arranca Uvicorn con --reload
# (1 proceso, recarga en caliente). "produccion" → sin --reload, con
# --workers (ver WORKERS_UVICORN abajo) — no cambia nada más por sí solo,
# ver docs/13-arquitectura.md sección 11 para qué falta para un despliegue
# de producción real.
ENTORNO=desarrollo
# Solo se usa cuando ENTORNO=produccion. Punto de partida conservador, no
# una medición — ajustar según los núcleos de la máquina real de despliegue.
WORKERS_UVICORN=4
# Rol restringido (RLS aplica) — usado por la app en runtime. Ver
# docs/16-seguridad.md y alembic/versions/0001_esquema_inicial_auth.py.
DATABASE_URL=postgresql+psycopg2://labsync_app:labsync_app@postgres:5432/labsync
# Rol con privilegios elevados — SOLO para Alembic (crea tablas, el rol
# labsync_app y sus GRANT). Nunca lo usa la aplicación en runtime.
DATABASE_URL_MIGRACIONES=postgresql+psycopg2://labsync:labsync@postgres:5432/labsync
# Pool del engine de runtime (ver core/config.py para la justificación
# completa) — los valores por defecto ya son correctos para el despliegue
# actual (1 proceso de API + 1 worker, sin balanceador); solo cambiar si el
# despliegue crece o el `max_connections` de Postgres es distinto de 100.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SEGUNDOS=1800
JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
# Rate limiting de /login y /refresh (formato slowapi "N/period").
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
# IPs del reverse proxy de confianza — vacío si la API no está detrás de
# ninguno (ver core/config.py). Ejemplo si lo hubiera: TRUSTED_PROXY_IPS=["10.0.0.5"]
TRUSTED_PROXY_IPS=[]
CORS_ORIGENES=["http://localhost:5173"]
# MinIO — ver core/config.py: `_interno` para tráfico servidor-a-servidor,
# `_publico` es el host que debe poder resolver el navegador (queda embebido
# en las URLs prefirmadas de subida/descarga).
MINIO_ENDPOINT_INTERNO=minio:9000
MINIO_ENDPOINT_PUBLICO=localhost:9000
MINIO_ACCESS_KEY=labsync
MINIO_SECRET_KEY=labsync123
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTOS=documentos
MINIO_BUCKET_EVIDENCIAS=evidencias
