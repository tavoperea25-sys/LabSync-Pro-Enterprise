# =============================================================================
# LabSync Pro Enterprise — .gitignore raíz
#
# Complementa (no reemplaza) a backend/.gitignore y frontend/.gitignore, que
# ya cubren correctamente el interior de sus propias carpetas. Este archivo
# añade cobertura a nivel raíz: IDEs, sistema operativo, y patrones que
# aplican a todo el repositorio (incluido design/login-prototype/).
# =============================================================================

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
*.egg-info/
.eggs/

# ---- Herramientas de calidad Python ----
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---- Node / React / Vite (frontend y prototipo de diseño) ----
node_modules/
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Variables de entorno y secretos ----
# El "!" reincluye los *.example (documentación de qué variables existen),
# nunca los archivos reales con valores.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
.keys/

# ---- Logs ----
*.log
logs/

# ---- Editores / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Sistema operativo ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Tooling local de asistente de IA (no es parte del proyecto versionado) ----
.claude/
.agents/

# Claude Code local metadata
skills-lock.json

# ---- Documentación interna no publicada en el repositorio (temporal) ----
# Auditoría de seguridad con detalle técnico completo — pendiente de decisión
# explícita sobre publicación pública. Los archivos permanecen en disco y en
# el proyecto; solo se excluyen del primer commit. No eliminar esta sección
# sin una decisión consciente de publicarlos.
docs/24-auditoria-independiente-2026-08-05.md
docs/25-release-candidate-1.md
